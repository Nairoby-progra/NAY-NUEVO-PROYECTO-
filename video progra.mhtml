    /// &lt;summary&gt;
    /// CU-01: gestion de propietarios.
    /// &lt;/summary&gt;
    public class PropietarioService
    {
        private readonly VeterinariaContext _context;

        /// &lt;param name=3D&quot;context&quot;&gt;Contexto de datos a uti=
lizar.&lt;/param&gt;
        public PropietarioService(VeterinariaContext context)
        {
            _context =3D context;
        }

        /// &lt;summary&gt;
        /// Registra un nuevo propietario.
        /// &lt;/summary&gt;
        /// &lt;param name=3D&quot;nombre&quot;&gt;Obligatorio.&lt;/param&g=
t;
        /// &lt;param name=3D&quot;telefono&quot;&gt;Obligatorio.&lt;/param=
&gt;
        /// &lt;param name=3D&quot;email&quot;&gt;Opcional; si se indica de=
be contener '@'.&lt;/param&gt;
        /// &lt;param name=3D&quot;direccion&quot;&gt;Opcional.&lt;/param&g=
t;
        /// &lt;returns&gt;El propietario creado, con su Id asignado.&lt;/r=
eturns&gt;
        /// &lt;exception cref=3D&quot;ArgumentException&quot;&gt;Si algun =
dato no es valido.&lt;/exception&gt;
        public Propietario Registrar(string nombre, string telefono, string=
 email, string direccion)
        {
            if (string.IsNullOrWhiteSpace(nombre))
                throw new ArgumentException(&quot;El nombre del propietario=
 es obligatorio.&quot;);
            if (string.IsNullOrWhiteSpace(telefono))
                throw new ArgumentException(&quot;El telefono es obligatori=
o.&quot;);
            if (!string.IsNullOrWhiteSpace(email) &amp;&amp; !email.Contain=
s(&quot;@&quot;))
                throw new ArgumentException(&quot;El email no tiene un form=
ato valido.&quot;);

            var propietario =3D new Propietario
            {
                Id =3D VeterinariaContext.SiguienteId(_context.Propietarios=
.Select(p =3D&gt; p.Id)),
                Nombre =3D nombre.Trim(),
                Telefono =3D telefono.Trim(),
                Email =3D email,
                Direccion =3D direccion
            };

            _context.Propietarios.Add(propietario);
            return propietario;
        }

        /// &lt;summary&gt;
        /// Lista todos los propietarios (con sus mascotas) ordenados por I=
d.
        /// &lt;/summary&gt;
        public List&lt;Propietario&gt; Listar()
        {
            return _context.Propietarios.OrderBy(p =3D&gt; p.Id).ToList();
        }
    }

