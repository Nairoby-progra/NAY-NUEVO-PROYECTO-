        /// &lt;summary&gt;
        /// Agenda una cita en estado &quot;Programada&quot;.
        /// &lt;/summary&gt;
        /// &lt;param name=3D&quot;mascotaId&quot;&gt;Debe existir.&lt;/par=
am&gt;
        /// &lt;param name=3D&quot;veterinarioId&quot;&gt;Debe existir.&lt;=
/param&gt;
        /// &lt;param name=3D&quot;fechaHora&quot;&gt;Debe ser posterior al=
 momento actual.&lt;/param&gt;
        /// &lt;param name=3D&quot;motivo&quot;&gt;Obligatorio.&lt;/param&g=
t;
        /// &lt;returns&gt;La cita creada.&lt;/returns&gt;
        /// &lt;exception cref=3D&quot;ArgumentException&quot;&gt;Si algun =
dato no es valido.&lt;/exception&gt;
        /// &lt;exception cref=3D&quot;InvalidOperationException&quot;&gt;
        /// Si el veterinario ya tiene una cita programada a esa misma hora=
.
        /// &lt;/exception&gt;
        public Cita Agendar(int mascotaId, int veterinarioId, DateTime fech=
aHora, string motivo)
        {
            if (!_context.Mascotas.Any(m =3D&gt; m.Id =3D=3D mascotaId))
                throw new ArgumentException(&quot;No existe una mascota con=
 Id &quot; + mascotaId + &quot;.&quot;);
            if (!_context.Veterinarios.Any(v =3D&gt; v.Id =3D=3D veterinari=
oId))
                throw new ArgumentException(&quot;No existe un veterinario =
con Id &quot; + veterinarioId + &quot;.&quot;);
            if (fechaHora &lt;=3D DateTime.Now)
                throw new ArgumentException(&quot;La fecha y hora de la cit=
a debe ser futura.&quot;);
            if (string.IsNullOrWhiteSpace(motivo))
                throw new ArgumentException(&quot;El motivo de la cita es o=
bligatorio.&quot;);

            bool horarioOcupado =3D _context.Citas.Any(c =3D&gt;
                c.VeterinarioId =3D=3D veterinarioId &amp;&amp;
                c.Estado =3D=3D EstadoCita.Programada &amp;&amp;
                c.FechaHora =3D=3D fechaHora);
            if (horarioOcupado)
                throw new InvalidOperationException(&quot;El veterinario ya=
 tiene una cita programada a esa hora.&quot;);

            var cita =3D new Cita
            {
                Id =3D VeterinariaContext.SiguienteId(_context.Citas.Select=
(c =3D&gt; c.Id)),
                MascotaId =3D mascotaId,
                VeterinarioId =3D veterinarioId,
                FechaHora =3D fechaHora,
                Motivo =3D motivo.Trim(),
                Estado =3D EstadoCita.Programada
            };

            _context.Citas.Add(cita);
            return cita;
        }

        /// &lt;summary&gt;
        /// Lista las citas que aun estan en estado &quot;Programada&quot;,=
 de la mas
        /// proxima a la mas lejana.
        /// &lt;/summary&gt;
        public List&lt;Cita&gt; ListarProgramadas()
        {
            return _context.Citas
                .Where(c =3D&gt; c.Estado =3D=3D EstadoCita.Programada)
                .OrderBy(c =3D&gt; c.FechaHora)
                .ToList();
