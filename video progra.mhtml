        // ----------------------------------------------------------------=
-----

        /// &lt;summary&gt;
        /// Muestra una etiqueta y lee una linea de texto (nunca devuelve n=
ull).
        /// &lt;/summary&gt;
        static string LeerTexto(string etiqueta)
        {
            Console.Write(etiqueta);
            string texto =3D Console.ReadLine();
            return texto =3D=3D null ? &quot;&quot; : texto.Trim();
        }

        /// &lt;summary&gt;
        /// Lee un numero entero.
        /// &lt;/summary&gt;
        /// &lt;exception cref=3D&quot;FormatException&quot;&gt;Si el texto=
 no es un entero.&lt;/exception&gt;
        static int LeerEntero(string etiqueta)
        {
            int valor;
            if (!int.TryParse(LeerTexto(etiqueta), out valor))
                throw new FormatException(&quot;Debe ingresar un numero ent=
ero valido.&quot;);
            return valor;
        }

        /// &lt;summary&gt;
        /// Lee un numero decimal de tipo double (usar punto decimal).
        /// &lt;/summary&gt;
        /// &lt;exception cref=3D&quot;FormatException&quot;&gt;Si el texto=
 no es un numero.&lt;/exception&gt;
        static double LeerDouble(string etiqueta)
        {
            double valor;
            if (!double.TryParse(LeerTexto(etiqueta), NumberStyles.Float, C=
ultureInfo.InvariantCulture, out valor))
                throw new FormatException(&quot;Debe ingresar un numero val=
ido (use punto decimal, ej. 12.5).&quot;);
            return valor;
        }

        /// &lt;summary&gt;
        /// Lee un monto monetario de tipo decimal (usar punto decimal).
        /// &lt;/summary&gt;
        /// &lt;exception cref=3D&quot;FormatException&quot;&gt;Si el texto=
 no es un numero.&lt;/exception&gt;
        static decimal LeerDecimal(string etiqueta)
        {
            decimal valor;
            if (!decimal.TryParse(LeerTexto(etiqueta), NumberStyles.Number,=
 CultureInfo.InvariantCulture, out valor))
                throw new FormatException(&quot;Debe ingresar un monto vali=
do (use punto decimal, ej. 150.50).&quot;);
            return valor;
        }

        /// &lt;summary&gt;
        /// Lee una fecha que debe respetar exactamente el formato indicado=
.
        /// &lt;/summary&gt;
        /// &lt;param name=3D&quot;etiqueta&quot;&gt;Texto que se muestra a=
l usuario.&lt;/param&gt;
        /// &lt;param name=3D&quot;formato&quot;&gt;Formato esperado, por e=
jemplo &quot;yyyy-MM-dd&quot;.&lt;/param&gt;
        /// &lt;exception cref=3D&quot;FormatException&quot;&gt;Si la fecha=
 no coincide con el formato.&lt;/exception&gt;
        static DateTime LeerFecha(string etiqueta, string formato)
        {
            DateTime fecha;
            if (!DateTime.TryParseExact(LeerTexto(etiqueta), formato, Cultu=
reInfo.InvariantCulture, DateTimeStyles.None, out fecha))
                throw new FormatException(&quot;Fecha invalida. Use el form=
ato &quot; + formato + &quot;.&quot;);
            return fecha;
        }
    }
