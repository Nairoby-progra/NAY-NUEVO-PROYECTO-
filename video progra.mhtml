    /// &lt;summary&gt;
    /// Contexto de datos en memoria. Sustituye al DbContext de Entity Fram=
ework.
    /// Cada lista funciona como una &quot;tabla&quot;.
    /// &lt;/summary&gt;
    public class VeterinariaContext
    {
        /// &lt;summary&gt;Tabla de propietarios.&lt;/summary&gt;
        public List&lt;Propietario&gt; Propietarios { get; private set; }

        /// &lt;summary&gt;Tabla de mascotas.&lt;/summary&gt;
        public List&lt;Mascota&gt; Mascotas { get; private set; }

        /// &lt;summary&gt;Tabla de veterinarios.&lt;/summary&gt;
        public List&lt;Veterinario&gt; Veterinarios { get; private set; }

        /// &lt;summary&gt;Tabla de citas.&lt;/summary&gt;
        public List&lt;Cita&gt; Citas { get; private set; }

        /// &lt;summary&gt;Tabla de consultas medicas.&lt;/summary&gt;
        public List&lt;Consulta&gt; Consultas { get; private set; }

        /// &lt;summary&gt;Tabla de facturas.&lt;/summary&gt;
        public List&lt;Factura&gt; Facturas { get; private set; }

        public VeterinariaContext()
        {
            Propietarios =3D new List&lt;Propietario&gt;();
            Mascotas =3D new List&lt;Mascota&gt;();
            Veterinarios =3D new List&lt;Veterinario&gt;();
            Citas =3D new List&lt;Cita&gt;();
            Consultas =3D new List&lt;Consulta&gt;();
            Facturas =3D new List&lt;Factura&gt;();
        }

        /// &lt;summary&gt;
        /// Equivalente a EnsureCreated(): deja la &quot;base de datos&quot=
; lista
        /// cargando los veterinarios iniciales si aun no existen.
        /// &lt;/summary&gt;
        public void EnsureCreated()
        {
            if (Veterinarios.Count =3D=3D 0)
            {
                Veterinarios.Add(new Veterinario { Id =3D 1, Nombre =3D &qu=
ot;Dra. Ana Lopez&quot; });
                Veterinarios.Add(new Veterinario { Id =3D 2, Nombre =3D &qu=
ot;Dr. Carlos Perez&quot; });
            }
        }

        /// &lt;summary&gt;
        /// Calcula el siguiente Id disponible para una lista de identifica=
dores.
        /// &lt;/summary&gt;
        /// &lt;param name=3D&quot;idsExistentes&quot;&gt;Ids ya usados.&lt=
;/param&gt;
        /// &lt;returns&gt;El mayor Id existente + 1 (o 1 si la lista esta =
vacia).&lt;/returns&gt;
        public static int SiguienteId(IEnumerable&lt;int&gt; idsExistentes)
        {
            int max =3D 0;
            foreach (int id in idsExistentes)
            {
                if (id &gt; max) max =3D id;
            }
            return max + 1;
        }
    }

