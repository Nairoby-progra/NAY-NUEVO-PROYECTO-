        /// &lt;summary&gt;
        /// Devuelve los veterinarios disponibles para agendar citas.
        /// &lt;/summary&gt;
        public List&lt;Veterinario&gt; ListarVeterinarios()
        {
            return _context.Veterinarios.OrderBy(v =3D&gt; v.Id).ToList();
        }
    }

