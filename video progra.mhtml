        /// &lt;summary&gt;
        /// Registra una mascota y la asocia a su propietario.
        /// &lt;/summary&gt;
        /// &lt;param name=3D&quot;propietarioId&quot;&gt;Debe existir.&lt;=
/param&gt;
        /// &lt;param name=3D&quot;nombre&quot;&gt;Obligatorio.&lt;/param&g=
t;
        /// &lt;param name=3D&quot;especie&quot;&gt;Perro, Gato u Otro (no =
distingue mayusculas).&lt;/param&gt;
        /// &lt;param name=3D&quot;raza&quot;&gt;Opcional.&lt;/param&gt;
        /// &lt;param name=3D&quot;fechaNacimiento&quot;&gt;No puede ser fu=
tura.&lt;/param&gt;
        /// &lt;returns&gt;La mascota creada, con su Id asignado.&lt;/retur=
ns&gt;
